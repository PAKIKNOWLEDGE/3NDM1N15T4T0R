{
  "name": "3NDM1N15T4T0R",
  "title": "Endfield 设计语言",
  "description": "工业编辑风：中性纸底/墨黑文字、全直角、1px 发丝线、单一信号色小面积点缀、编号双语标签、超粗实心大字硬压背景。本文件是所有数值的唯一来源。",
  "version": "1.0.0",
  "principles": [
    "中性底：背景只有纸白与近黑两档，杜绝彩色大面积铺底",
    "单信号色：强调色覆盖率 < 5%/屏，只落于标题局部 / 1px 线 / 小几何符号 / 单色块，绝不用于正文",
    "全直角：border-radius 恒为 0（圆形仅作母题，如圆点）",
    "靠字重与字距分层，不靠阴影与圆角；阴影只允许 0 1px 0 hairline"
  ],
  "color": {
    "light": {
      "paper": "#e8e8e2",
      "panel": "#f2f2ec",
      "card": "#dcddd6",
      "ink": "#101110",
      "muted": "#4a4c48",
      "line": "#d8d9d5",
      "accent": "#6b5d00",
      "shadow": "rgba(16,17,16,.10)",
      "colorScheme": "light"
    },
    "dark": {
      "paper": "#101110",
      "panel": "#181a18",
      "card": "#1e201d",
      "ink": "#f5f5f0",
      "muted": "#898d89",
      "line": "#343633",
      "accent": "#fff500",
      "shadow": "rgba(0,0,0,.5)",
      "colorScheme": "dark"
    },
    "signalColors": {
      "valleyYellow": { "hex": "#fff500", "role": "默认主信号色（谷地黄）" },
      "wulingCyan": { "hex": "#14d0d0", "role": "备选信号色（武陵青）" }
    },
    "accentSinkRule": {
      "rule": "亮色态下强调色用作文字时必须下潜为深色以保证对比度",
      "mapping": { "#fff500": "#6b5d00" },
      "exception": "用作色块/线条时可保留原色（信号色块 + 墨色文字对比度更高）"
    },
    "semantics": {
      "yellow": "测试 / 公测 / 主信号",
      "cyan": "备选信号",
      "red": "事件 / 前瞻（本语言中仅限状态警示，如 overdue）",
      "green": "版本 / 自然主题（不用于状态）"
    },
    "quota": {
      "accentAreaMaxPercentPerScreen": 5,
      "accentAllowedTargets": ["标题局部", "1px 线", "小几何符号", "单一色块"],
      "forbidden": "正文段落着色",
      "minTextContrastRatio": 4.5
    }
  },
  "typography": {
    "families": {
      "body": "\"HarmonyOS Sans SC\", MiSans, ui-monospace, \"Cascadia Mono\", Consolas, Menlo, monospace",
      "display": "\"Arial Black\", \"HarmonyOS Sans SC\", Arial, sans-serif",
      "mono": "ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, Menlo, monospace"
    },
    "displayWeight": 900,
    "displayLetterSpacing": ".02em",
    "numericVariant": "tabular-nums",
    "metaUppercaseLetterSpacing": ".12em-.14em",
    "scale": [
      { "px": 11, "usage": "元信息 / 标签 / 导航 / 状态栏（uppercase）" },
      { "px": 13, "usage": "次要数据 / 表格" },
      { "px": 14, "usage": "正文基准" },
      { "px": 15, "usage": "长文阅读区" },
      { "px": 16, "usage": "列表条目标题" },
      { "px": 24, "usage": "区块大标题" },
      { "px": 34, "usage": "时钟 / 详情页标题（display 900）" },
      { "px": 46, "usage": "装饰幽灵大字" }
    ],
    "lineHeights": { "meta": 1.65, "display": "0.95-1.3" },
    "bilingualPattern": "中文大字 + 其下英文小字（uppercase，字距 .12em+，muted 色）",
    "embeddedFont": {
      "family": "HarmonyOS Sans SC",
      "files": ["assets/fonts/HarmonyOS_Sans_SC_Regular.woff2", "assets/fonts/HarmonyOS_Sans_SC_Bold.woff2"],
      "subset": "GB2312 全部汉字 + ASCII + 常用符号（7545 字符），子集外字符按字符回退栈内下一字体",
      "license": "assets/fonts/LICENSE-HarmonyOS-Sans.txt"
    }
  },
  "layout": {
    "containerMaxWidth": "1180px",
    "grid": { "columns": "250px 1fr 300px", "gap": "14px" },
    "density": { "cssVar": "--cols", "values": [2, 3, 4], "default": 3 },
    "breakpoint": { "px": 920, "behavior": "单列，次要面板重排到主内容之后" },
    "panelPadding": "16px 18px",
    "panelGap": "14px",
    "cornerAnchors": { "topLeft": "标识 / 品牌", "bottomRight": "版本号 + LAST BUILD 时间（时间必须带标签）" },
    "instrumentVocabulary": ["Section", "Column - 3 +", "◎", "＋", "−", "✕"]
  },
  "components": {
    "topbar": { "border": "1px solid var(--line)", "fontSize": "11px", "transform": "uppercase", "color": "var(--muted)", "brandColor": "var(--accent)" },
    "nav": { "shape": "1px 描边、无下边框的标签", "active": "color: var(--accent)" },
    "panel": { "background": "var(--panel)", "border": "1px solid var(--line)", "boxShadow": "0 1px 0 var(--shadow)" },
    "label": { "fontSize": "11px", "transform": "uppercase", "format": "[01 // VAULT]", "brackets": "signal color, ::before '[' ::after ']'" },
    "stat": { "layout": "两端对齐", "valueColor": "var(--accent)" },
    "row": { "borderBottom": "1px solid var(--line)", "lastChild": "无下边框", "titleSize": "16px", "metaNowrap": true },
    "tag": { "fontSize": "11px", "color": "var(--muted)", "prefix": "#" },
    "statusbar": { "fontSize": "11px", "transform": "uppercase", "borderTop": "1px solid var(--line)", "borderBottom": "3px solid var(--accent)" },
    "button": { "background": "none", "border": "1px solid var(--line)", "fontSize": "11px", "transform": "uppercase" }
  },
  "interaction": {
    "hover": "信号色实心反白：background: var(--accent); border-color: var(--accent); color: var(--ink)",
    "selection": "background: var(--accent); color: var(--paper)",
    "focusVisible": "outline: 2px solid var(--accent); outline-offset: 2px",
    "scrollbar": { "width": "6px（WebKit）", "thumb": "var(--line)", "track": "transparent", "firefox": "scrollbar-width: thin; scrollbar-color: var(--line) transparent" },
    "transitions": "基线无 transition，hover/focus 即时生效；只加状态切换类动效，不加入场表演类（loader 例外）"
  },
  "decorations": {
    "leftRuler": {
      "css": "repeating-linear-gradient(to bottom, var(--line) 0, var(--line) 1px, transparent 1px, transparent 10px)",
      "width": "5px",
      "opacity": 0.75,
      "usage": "面板左缘竖向刻度尺（工业仪器感）"
    },
    "ghostWord": {
      "font": "\"Arial Black\", Arial, sans-serif 900",
      "fontSize": "46px",
      "opacity": 0.055,
      "position": "absolute; right: 12px; bottom: -.36em（容器 overflow:hidden 裁掉下半截）",
      "trigger": "容器 data-word 属性",
      "usage": "右下的巨大英文模块名，纯装饰"
    },
    "bracketedTitle": { "usage": "区块标题两侧 [ ]，信号色（官方主视觉最高频符号，6 张封面中 4 张使用）" },
    "bottomEdgeBand": { "height": "3px", "color": "var(--accent)", "usage": "内容区底部收边（官方主视觉的底部收边手法）" },
    "darkGrid": {
      "pitch": "28px",
      "lineWidth": "1px",
      "alpha": 0.03,
      "color": "rgba(245,245,240,.03)",
      "scope": "仅暗色态可选，亮色态为纯纸色",
      "css": "repeating-linear-gradient(0deg,...),repeating-linear-gradient(90deg,...)"
    }
  },
  "motion": {
    "loader": {
      "overlayBackground": "#0a0b0a",
      "rail": { "width": "10px", "color": "#fff500", "direction": "top-to-bottom" },
      "readout": { "position": "跟随填充端下移", "clampPercent": 94, "font": "11px mono, letter-spacing .14em, #f5f5f0" },
      "brandBlock": { "layout": "整体右置、内部左对齐，双行紧排（如 END/FIELD）", "fontSize": "clamp(26px, 5.2vh, 64px)", "color": "#f5f5f0" },
      "timing": {
        "totalMs": 1500,
        "phases": [
          { "name": "progress", "ms": 900, "easing": "easeOutCubic" },
          { "name": "expand", "ms": 300, "detail": "10px 宽横向展开至整屏" },
          { "name": "fade", "ms": 300 }
        ],
        "shortVariantMs": { "totalMs": 850, "phases": [350, 300, 200] },
        "trigger": "每次进页播放完整版；皮肤/主题切入时播放短版"
      },
      "engineeringConstraints": [
        "进度由墙钟时间推导（Date.now），不逐帧累加",
        "requestAnimationFrame 平滑 + setInterval(50ms) 兜底（后台标签页 rAF 停摆）",
        "独立 setTimeout(total+800ms) 硬性保险丝，保证遮罩必定移除",
        "重复触发幂等（已存在遮罩则跳过）",
        "pointer-events: none 且 aria-hidden=\"true\"",
        "prefers-reduced-motion: reduce 时完全不播放"
      ]
    },
    "baseline": "无 transition；不引入视差/滚动动画/淡入队列"
  },
  "antiPatterns": [
    "圆角 / 胶囊按钮",
    "彩色大面积铺底、渐变按钮、毛玻璃、霓虹发光",
    "悬浮投影卡片（只允许 0 1px 0 发丝线阴影）",
    "强调色用于正文或长段落",
    "emoji 当图标（几何符号只用 ◯ ● ＋ − ✕ ◎ ▶ ◀）",
    "同时叠加两种以上纹理",
    "文字与底色对比度 < 4.5:1",
    "超过两种字体家族 + 一种等宽之外的选择",
    "裸时间戳（必须带 LAST BUILD 之类标签）"
  ],
  "preflightChecklist": [
    "强调色面积 < 5% 且正文零着色",
    "无非 0 圆角、无彩色大底、无渐变按钮",
    "亮色态强调色文字已下潜（#fff500 → #6b5d00）",
    "所有文字对比度 ≥ 4.5:1",
    "数字启用 tabular-nums；元信息 11px 大写 + 字距",
    "区块标题带 [ ] 方括号与编号双语",
    "至少使用刻度尺 / 幽灵大字 / 底部 3px 收边带中的两种",
    "loader（若使用）时序 900/300/300（短版 350/300/200）且六条工程约束齐全",
    "遵守 prefers-reduced-motion",
    "时间戳带标签"
  ]
}
